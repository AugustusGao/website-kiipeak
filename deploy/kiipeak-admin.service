[Unit]
Description=KiiPeak admin
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=kiipeak
WorkingDirectory=/opt/kiipeak
Environment=PYTHONUNBUFFERED=1
Environment=KIIPEAK_DATA=/var/lib/kiipeak/data
ExecStart=/opt/kiipeak/.venv/bin/python -m kiipeak.cli admin
UMask=0007
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kiipeak /var/www/kiipeak 
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
